# Database Configuration
DB_NAME=webhook_delivery
DB_USER=postgres
DB_PASSWORD=changeme_in_production

# Spring datasource (used when running outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/webhook_delivery
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme_in_production

# Delivery worker poll interval (ms)
WEBHOOK_WORKER_DELAY=1000

# SSRF protection — set true only for local dev
WEBHOOK_ALLOW_INTERNAL_IPS=false
